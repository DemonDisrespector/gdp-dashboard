# ── Conduit Backend – Environment Variables ───────────────────────────────────
# Copy to .env and fill in real values. Never commit .env to version control.

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# Database
DATABASE_URL=postgresql+asyncpg://conduit:conduit@localhost:5432/conduit

# ModMed / FHIR Source OAuth 2.0
MODMED_BASE_URL=https://api.modmed.com/fhir/r4
MODMED_TOKEN_URL=https://api.modmed.com/oauth2/token
MODMED_CLIENT_ID=your-client-id-here
MODMED_CLIENT_SECRET=your-client-secret-here
MODMED_SCOPE=fhir.read

# Encryption (HMAC key for patient token derivation)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=dev-only-32-byte-key-replace-me!

# Feature flags
ENABLE_BROWSER_CONNECTOR=false
ENABLE_FHIR_WRITE_CONNECTOR=true

# CORS – comma-separated
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
